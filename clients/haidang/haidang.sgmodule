#!status=running
#!url=https://raw.githubusercontent.com/kass-png/Shadowrocket-Modules/refs/heads/Locket/clients/haidang/haidang.sgmodule

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/kass-png/Shadowrocket-Modules/refs/heads/Locket/clients/haidang/haidang_main.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/kass-png/Shadowrocket-Modules/refs/heads/Locket/clients/haidang/haidang_deleteheader.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
