#!name=Locket Gold
#!desc=By: Kass
#!author=Kass
#!version=1.0
#!expire=null
#!client=null
#!status=running

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/kass-png/Shadowrocket-Modules/refs/heads/Locket/kass.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/kass-png/Shadowrocket-Modules/refs/heads/Locket/deleteheaders.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
